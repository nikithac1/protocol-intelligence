# Copy to .env (scripts/setup-credentials.ps1 does this for you). .env is gitignored.

# --- AWS ---
# Named profile in ~/.aws/credentials or ~/.aws/config (SSO). Leave blank to use the default chain.
AWS_PROFILE=protocol-dev
AWS_REGION=us-east-1

# --- Amazon Bedrock ---
# Optional Bedrock API key. boto3 / Strands pick this up automatically for bedrock-runtime calls.
# Control-plane calls (AgentCore, S3, list models) still use the AWS profile above.
AWS_BEARER_TOKEN_BEDROCK=

# Model IDs are configuration: confirm availability with
#   aws bedrock list-inference-profiles --region us-east-1 --profile protocol-dev
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Project resources (filled in as they are provisioned) ---
S3_BUCKET=
AGENTCORE_MEMORY_ID=
AGENTCORE_RUNTIME_ARN=

# --- Admin portal (http://127.0.0.1:8000/admin) ---
# Required as the x-admin-key header on /api/admin/* when set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- ClinicalTrials.gov ---
CTGOV_API_BASE=https://clinicaltrials.gov/api/v2
